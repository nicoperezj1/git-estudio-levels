# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Resend (para envio de boletas)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=EstudioLevels <boletas@estudiolevels.com>

# App
# En produccion debe ser el dominio final con https (es la base de los links de pago y
# de las direcciones que Mercado Pago usa para avisar y para devolver al cliente).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MercadoPago (cobro de ventas y abonos de CADA negocio; cada negocio puede guardar el suyo)
MERCADOPAGO_ACCESS_TOKEN=tu-access-token
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=tu-public-key

# TUU (Haulmer) - Pago Remoto (fallback global, normalmente se configura por tenant
# desde Configuracion -> TUU)
TUU_API_KEY=tu-api-key-de-tuu

# Web Push (generar con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=tu-vapid-public-key
VAPID_PRIVATE_KEY=tu-vapid-private-key

# Cron Jobs (Vercel)
CRON_SECRET=tu-cron-secret-random

# --- Suscripciones de re-booking (cobro a los negocios, cuenta de re-booking en Mercado Pago) ---
# Access Token de PRODUCCION de la aplicacion de re-booking en Mercado Pago
# (Tus integraciones > la aplicacion > Credenciales de produccion). Nunca lo subas al repo.
MP_PLATFORM_ACCESS_TOKEN=APP_USR-tu-token-de-produccion
# Clave secreta del webhook (Tus integraciones > Webhooks > Clave secreta). Con ella la ruta
# /api/checkout/subscribe/webhook verifica la firma de cada aviso. Sin ella NO se valida
# (solo aceptable en desarrollo).
MP_WEBHOOK_SECRET=tu-clave-secreta-del-webhook
# SOLO DESARROLLO LOCAL: URL https publica (tunel) hacia localhost:3000, porque Mercado Pago
# exige https en back_url y notification_url. NO definir en produccion.
# MP_PUBLIC_URL=https://tu-tunel.trycloudflare.com
