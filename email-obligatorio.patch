 src/app/api/public/book/route.ts            | 13 ++++++++++++-
 src/app/booking/page.tsx                    |  9 +++++----
 3 files changed, 20 insertions(+), 6 deletions(-)

diff --git a/src/app/api/booking/create-deposit/route.ts b/src/app/api/booking/create-deposit/route.ts
index bfdd96a..510a1ed 100644
--- a/src/app/api/booking/create-deposit/route.ts
+++ b/src/app/api/booking/create-deposit/route.ts
@@ -13,6 +13,8 @@ import { createAdminSupabase } from "@/lib/supabase/server";
  * 4. Client pays on MP
  * 5. Webhook confirms → appointment changes to "confirmed"
  */
+const isValidEmail = (e: unknown) => typeof e === "string" && /^\S+@\S+\.\S+$/.test(e.trim());
+
 export async function POST(req: NextRequest) {
   const supabase = createAdminSupabase();
   const body = await req.json();
@@ -28,7 +30,7 @@ export async function POST(req: NextRequest) {
     notes,
   } = body;
 
-  if (!barberId || !serviceIds?.length || !date || !startTime || !clientName || !totalPrice) {
+  if (!barberId || !serviceIds?.length || !date || !startTime || !clientName || !isValidEmail(clientEmail) || !totalPrice) {
     return NextResponse.json({ error: "Campos requeridos faltantes" }, { status: 400 });
   }
 
diff --git a/src/app/api/public/book/route.ts b/src/app/api/public/book/route.ts
index ccfcae5..9dcfd2a 100644
--- a/src/app/api/public/book/route.ts
+++ b/src/app/api/public/book/route.ts
@@ -1,6 +1,6 @@
 import { isTenantSuspended, isBarberTenantSuspended, TENANT_SUSPENDED_MESSAGE } from "@/lib/tenant-suspension";
 import { NextRequest, NextResponse } from "next/server";
-import { createAdminSupabase } from "@/lib/supabase/server";
+import { createAdminSupabase, getCurrentUserRoleAndTenant } from "@/lib/supabase/server";
 import { sendBookingConfirmation } from "@/lib/resend";
 import { tryConsumeQuota } from "@/lib/message-quota";
 import { isSlotFull, exceededAfterInsert } from "@/lib/capacity";
@@ -10,6 +10,8 @@ import { getWindowDays, isBeyondWindow } from "@/lib/booking-window";
 import { notify } from "@/lib/notify";
 import { sanitizeAttribution, isAdTrackingEnabled } from "@/lib/ad-tracking";
 
+const isValidEmail = (e: unknown) => typeof e === "string" && /^\S+@\S+\.\S+$/.test(e.trim());
+
 export async function POST(req: NextRequest) {
   const supabase = createAdminSupabase();
   const body = await req.json();
@@ -23,6 +25,15 @@ export async function POST(req: NextRequest) {
     return NextResponse.json({ error: "Campos requeridos faltantes" }, { status: 400 });
   }
 
+  // El correo es obligatorio para quien reserva online. El personal con sesion (agenda del
+  // profesional, clientes sin correo) queda fuera de la regla.
+  if (!isValidEmail(clientEmail)) {
+    const caller = await getCurrentUserRoleAndTenant();
+    if (!caller.role) {
+      return NextResponse.json({ error: "El correo es obligatorio" }, { status: 400 });
+    }
+  }
+
   // Get services details
   const { data: services } = await supabase
     .from("services")
